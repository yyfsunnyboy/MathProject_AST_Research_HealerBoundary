  "mapping_rules": [
    "One-to-one where names already match across Qwen and Gemini Phase reports.",
    "Many-to-one only for evaluator_status synonyms into L0–L5 via preliminary_failure_layer.",
    "Do not merge distinct Ab3 outcomes.",
    "Do not rewrite stored Qwen artifacts; mapping is for aggregation views only.",
    "triggered_changed_still_fail → layer_exposure always."
  ]
